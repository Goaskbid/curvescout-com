<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>CurveScout.com — curve intelligence for motorcycle road trips</title>
  <meta name="description" content="CurveScout.com scouts motorcycle roads outside traffic: map-first road trips, technical profiles, audited pictures, waypoints, road status, weather context and GPX / Google route handoff.">
  <link rel="manifest" href="manifest.webmanifest">
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <div class="movingBackdrop" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
  <img class="helmetWatermark" src="assets/curvescout-helmet-visual.png" alt="" aria-hidden="true">

  <header class="siteHeader">
    <a class="brand" href="#planner" title="CurveScout.com: we scout the curves.">
      <img class="brandMark" src="assets/curvescout-mark-transparent.png" alt="CurveScout.com logo">
      <div>
        <h1>CurveScout.com</h1>
        <p>We scout the curves. Find. Map. Master.</p>
      </div>
    </a>


    <a class="friend" href="https://www.cerebral.ch/" target="_blank" rel="noopener" title="Friend window: Stiftung Cerebral">
      <img src="assets/cerebral-local.svg" alt="Stiftung Cerebral logo">
      <div><b>Friend window</b><span>Stiftung Cerebral · mobility matters.</span></div>
      <strong>Visit</strong>
    </a>


    <nav class="nav" aria-label="Primary navigation">
      <button class="navBtn" data-target="planner" title="Set start, range and riding style">Planner</button>
      <button class="navBtn" data-target="stage" title="Inspect the selected road trip on the main map">Map</button>
      <button class="navBtn" data-target="candidates" title="Compare road-trip candidates near your start">Road trips</button>
      <button class="navBtn" data-target="details" title="Technical profile, status layers and roadbook">Details</button>
      <button class="navBtn" data-target="inlineRoadbook" title="Sections and waypoints in riding order">Roadbook</button>
      <button class="navBtn" data-target="navigation" title="Download GPX or open Google / OSM route checks">Navigate</button>
    </nav>
  </header>

  <main class="app">
    <section class="panel planner" id="planner">
      <div class="introCopy">
        <span class="eyebrow">Start anywhere</span>
        <h2>Find rides outside the traffic, not laps around the block.</h2>
        <p>Search a city, village, pass or hotel. CurveScout.com keeps the map central, builds the transfer from your actual start, and ranks rideable road trips nearby: scenic exits, water, ridges, high roads, fuel, food, sights, road status and usable navigation handoff.</p>
      </div>

      <form class="searchForm" id="searchForm">
        <div class="field startField">
          <label for="startInput">Start place</label>
          <input id="startInput" value="Zurich" autocomplete="off" spellcheck="false" title="Type any city, village, pass, hotel or coordinates.">
        </div>
        <div class="field finishField">
          <label for="finishInput">Finish place</label>
          <input id="finishInput" value="" placeholder="same as start" autocomplete="off" spellcheck="false" title="Optional. Leave empty for a loop back to the start, or set a different finish point.">
        </div>
        <div class="field compactField">
          <label for="rangeInput">Range</label>
          <select id="rangeInput" title="Approximate riding range used for ranking">
            <option value="120">120 km short escape</option>
            <option value="180">180 km half day</option>
            <option value="260" selected>260 km day ride</option>
            <option value="420">420 km long day</option>
            <option value="680">680 km overnight</option>
          </select>
        </div>
        <div class="field compactField">
          <label for="styleInput">Style</label>
          <select id="styleInput" title="Route scoring bias">
            <option value="touring">Touring</option>
            <option value="sport">Sport touring</option>
            <option value="easy">Easy scenic</option>
            <option value="adventure">Adventure</option>
          </select>
        </div>
        <button class="primary" title="Find road trips near the selected start">Find road trips</button>
        <button class="geo" type="button" id="geoBtn" title="Use your current location as the start point">Use current location</button>
        <div class="statusLine" id="statusLine">Ready.</div>
      </form>
    </section>

    <section class="workspace" id="stage">
      <article class="panel stage">
        <div class="selectedHeader">
          <div>
            <span class="eyebrow">Selected road trip</span>
            <h2 id="selectedTitle">Choose a road trip.</h2>
            <p id="selectedSlogan"></p>
          </div>
          <div class="scoreDial" title="Overall route score from scenic value, flow, technical interest, surface confidence, traffic escape and risk discipline"><span id="scoreValue">--</span><small>score</small></div>
        </div>

        <div class="quickActions" id="quickActions" aria-label="Navigation actions"></div>
        <div class="intelGrid" id="intelGrid"></div>
        <div class="conditionBoard" id="conditionBoard" aria-label="Weather, road and ride condition board"></div>

        <div class="mediaGrid">
          <div class="mapCanvas" id="mainMap" title="Hover route sections, waypoints, speed/control markers and risk markers. The internal map, GPX and Google preview use the same checkpoint order."></div>
          <div class="hero" title="Hero picture for the selected road trip"><img id="heroImg" alt="selected road trip picture"><span class="mediaLoadingBadge" data-media-progress>Open photos loading</span><div class="heroText"><h3>Why this ride works</h3><p id="selectedStory"></p></div></div>
        </div>

        <div class="inlineRoadbook" id="inlineRoadbook" aria-label="Riding order: sections and waypoints">
          <div class="inlineRoadbookHead"><span class="eyebrow">Riding order</span><h3>Road sections with short checkpoints, exactly as exported</h3><p>Sections carry the riding detail: sights, fuel, food, road status, safety, traffic, rest and swimming. Waypoints stay brief so the order remains readable.</p></div>
          <div class="inlineRoadbookList" id="inlineRoadbookList"></div>
        </div>

        <div class="scoreGrid" id="scoreBreakdown"></div>
        <div class="facts" id="selectedFacts"></div>
        <div class="rideAdviceGrid" id="rideAdviceGrid"></div>
      </article>

      <aside class="panel candidatePanel" id="candidates">
        <div class="candidateHead">
          <span class="eyebrow">Road-trip candidates</span>
          <h2>Top road trips near your start.</h2>
          <p>Choose a ride; map, profile, roadbook, pictures and GPX update immediately.</p>
        </div>
        <div id="candidateList"></div>
      </aside>
    </section>

    <section class="panel profilePanel" id="details">
      <div class="sectionHead">
        <div><span class="eyebrow">Technical instrument</span><h2>Altitude, road character, weather, traffic and risk layers</h2></div>
        <button id="snapBtn" title="Reload route geometry from the routing engine">Refresh route line</button>
      </div>
      <div class="roadStatusStack" id="roadStatusStack"></div>
      <div class="profileBox" id="profile"></div>
    </section>

    <section class="panel roadbookPanel" id="roadbook">
      <div class="sectionHead"><div><span class="eyebrow">Roadbook</span><h2>Road sections and checkpoints in riding order</h2></div></div>
      <div class="roadbookList" id="roadbookGrid"></div>
    </section>

    <section class="panel navPanelBox" id="navigation">
      <div class="sectionHead"><div><span class="eyebrow">Navigation</span><h2>Use the same checkpoint order everywhere</h2></div></div>
      <div class="navPanel" id="navPanel"></div>
    </section>

    <section class="panel sources" id="sources">
      <span class="eyebrow">Sources and credits</span>
      <h2>Map, route and media credits</h2>
      <p>CurveScout.com shows map context, road-trip planning data, open media links and status sources. The rider still checks posted signs, official closures and weather before the ride.</p>
      <div class="sourceLinks"><a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a><a href="https://project-osrm.org/" target="_blank" rel="noopener">OSRM</a><a href="https://www.google.com/maps" target="_blank" rel="noopener">Google Maps</a><a href="https://commons.wikimedia.org/wiki/Commons:API" target="_blank" rel="noopener">Wikimedia Commons</a><a href="https://open-meteo.com/" target="_blank" rel="noopener">Open-Meteo</a></div>
    </section>
  </main>

  <button class="backTop" id="backTop" aria-label="Back to top" title="Back to top">↑</button>
  <script src="data/routes.js"></script>
  <script src="app.js"></script>
</body>
</html>
