 "guides": [
  {
   "id": "mara_line",
   "name": "Mara",
   "descriptor": "The Line",
   "domain": "sporty_curvy",
   "required": [
    "routed_geometry",
    "curve_metrics"
   ],
   "templates": [
    "The best flow runs from {{segment_start}} to {{segment_end}}.",
    "{{bend_section_km}} km of sustained bends. {{traffic_timing_note}}",
    "Reverse it when {{direction_reason}}."
   ],
   "icon": "🏍️",
   "accentHex": "#c81d2a"
  },
  {
   "id": "kenji_view",
   "name": "Kenji",
   "descriptor": "The View",
   "domain": "scenic",
   "required": [
    "routed_or_verified_corridor",
    "verified_viewpoint_or_landscape_tag"
   ],
   "templates": [
    "The view opens after {{location_name}}. Stop before the descent.",
    "{{viewpoint_name}} adds about {{detour_minutes}} minutes.",
    "Best light around {{light_window}}, based on your departure time."
   ],
   "icon": "⛰️",
   "accentHex": "#3f8f8a"
  },
  {
   "id": "elise_stop",
   "name": "Elise",
   "descriptor": "The Stop",
   "domain": "food_stopovers",
   "required": [
    "stop_location",
    "detour_or_on_route_distance"
   ],
   "templates": [
    "{{place_name}} sits on the line - worth the stop for {{verified_reason}}.",
    "{{place_name}} is {{detour_minutes}} minutes off the line and worth the stop for {{verified_reason}}.",
    "You should reach {{place_name}} around {{arrival_time}}. {{opening_status_with_timestamp}}",
    "Fuel before {{route_section}}. The next confirmed option is {{fuel_gap_km}} km later."
   ],
   "icon": "🍴",
   "accentHex": "#c1913a"
  },
  {
   "id": "leon_story",
   "name": "Leon",
   "descriptor": "The Story",
   "domain": "history_culture",
   "required": [
    "historical_source",
    "poi_location"
   ],
   "templates": [
    "{{place_name}} is a named road in its own right: {{documented_note}}",
    "{{place_name}} matters because {{verified_history_fact}}.",
    "Stop on the {{parking_side}} side. The detour adds {{detour_minutes}} minutes.",
    "This section follows {{verified_road_history_summary}}."
   ],
   "icon": "🏰",
   "accentHex": "#8e2c43"
  },
  {
   "id": "noor_brief",
   "name": "Noor",
   "descriptor": "The Brief",
   "domain": "conditions_day_fit",
   "required": [
    "route_duration"
   ],
   "templates": [
    "Leave by {{latest_departure}} to be home by {{back_by}}.",
    "Summit forecast: {{summit_temp_c}} C, freezing level {{freezing_level_m}} m. Checked {{weather_checked_at}}.",
    "{{verdict_label}} because {{verdict_reason}}."
   ],
   "icon": "🌦️",
   "accentHex": "#d99a1e"
  },
  {
   "id": "tomas_detour",
   "name": "Tomas",
   "descriptor": "The Detour",
   "domain": "adventure_remote",
   "required": [
    "surface_or_route_classification"
   ],
   "templates": [
    "{{surface_summary}}. {{surface_confidence_note}}",
    "Save the roadbook before {{low_signal_section_name}}.",
    "Fuel before {{remote_section_name}}. The next confirmed option is {{fuel_gap_km}} km later."
   ],
   "icon": "🧭",
   "accentHex": "#6b8e3d"
  }
 ],
